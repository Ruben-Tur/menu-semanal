# Copia este archivo como .env para cambiar la configuración (es opcional).

# Puerto del servidor estático.
PORT=4323

# Interfaz en la que escucha. 127.0.0.1 = solo este equipo.
HOST=127.0.0.1

# URL pública (sin barra final). Se usa en la URL canónica, Open Graph, sitemap.xml,
# robots.txt y llms.txt. Con https se activan también HSTS y upgrade-insecure-requests.
SITE_URL=http://localhost:4323
